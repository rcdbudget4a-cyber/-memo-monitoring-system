{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memo-monitoring-system",
  "main": "./_worker.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
